# QXio environment sample — copy to .env and fill in. (.env is gitignored.)
# Everything here is OPTIONAL: with none of it set, the app runs on the local
# PGLite fallback and the SMS path uses the phone's own Messages app.

# --- Database (production) ---
# Set to a Neon/Postgres URL to use a real DB. Unset = embedded PGLite (preview).
DATABASE_URL=

# --- SMS inbound (a handset texting QXio → shows up in the chat) ---
# POST /api/sms is rejected until this is set. Send it from your aggregator as
# header  x-qxio-sms-secret: <secret>   (or ?secret=<secret> on the URL).
# Twilio users can rely on TWILIO_AUTH_TOKEN instead of setting this.
SMS_WEBHOOK_SECRET=

# --- SMS outbound (QXio → a handset with no data; the true no-data path) ---
# OFF unless SMS_OUTBOUND=1 AND one provider block below is filled in.
# Sending real SMS costs your network's tariff, so this never auto-enables.
SMS_OUTBOUND=

# Africa's Talking (SA-friendly). AT_SANDBOX=1 to hit the sandbox endpoint.
AT_USERNAME=
AT_API_KEY=
AT_FROM=
AT_SANDBOX=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Clickatell
CLICKATELL_API_KEY=
CLICKATELL_FROM=
